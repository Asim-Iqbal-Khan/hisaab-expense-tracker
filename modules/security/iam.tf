# ==========================================================================
# IAM roles — §11
# ==========================================================================
# Every S3, Secrets Manager, SQS, and SES permission below names a specific
# ARN, no wildcards on resources. One documented exception:
# ecr:GetAuthorizationToken does not support resource-level permissions at
# all — AWS requires Resource = "*" for this specific action; it is not a
# scoping choice.
#
# Several ARNs reference resources that don't exist until later phases
# (the SQS queue and SES identity in phase 6, the ECR repo in phase 8). Those names are
# fixed strings from the spec (or chosen here and honored later), so the
# ARNs are fully deterministic even though the resources aren't created yet.
#
# Two permissions are deliberately NOT included here, both for the same
# reason: their target's identifier is generated by AWS at creation time
# and can't be predicted.
#
#  1. secretsmanager:GetSecretValue on the RDS master password secret.
#     The spec calls for RDS-managed rotation, i.e. the native
#     manage_master_user_password feature — RDS creates and owns that
#     secret under an AWS-chosen name (rds!db-<uuid>), not one we pick.
#     modules/data attaches this permission once the DB (and its secret)
#     exists, via the role_*_name outputs below passed in as its inputs.
#  2. codestar-connections:UseConnection for role-codepipeline, scoped to
#     the GitHub CodeStar connection's ARN — created in modules/pipeline,
#     phase 8.
#  3. cloudfront:CreateInvalidation for role-codebuild, scoped to the
#     CloudFront distribution's ARN — created in modules/delivery, which
#     attaches it the same way modules/data attaches (1), via the
#     role_codebuild_name output below.
#  4. ec2:RunInstances for role-codedeploy, scoped to the launch template's
#     ARN — created in modules/compute (the launch template's ID is
#     AWS-generated), which attaches it the same way, via the
#     role_codedeploy_name output below. Required alongside the
#     ec2:DescribeLaunchTemplate* grant further down in this file:
#     "authorized to READ a launch template" and "authorized to USE one via
#     CreateAutoScalingGroup" are two separate IAM checks — confirmed by
#     getting AWS's exact error text ("not authorized to use launch
#     template") via a direct assume-role test, distinct from the generic
#     wrapped error CodeDeploy shows by default.

locals {
  ecr_repo_arn                  = "arn:aws:ecr:${var.aws_region}:${data.aws_caller_identity.current.account_id}:repository/${var.ecr_repo_name}"
  sqs_queue_arn                 = "arn:aws:sqs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:${var.sqs_queue_name}"
  profile_pics_bucket_arn       = "arn:aws:s3:::${var.profile_pics_bucket_name}"
  pipeline_artifacts_bucket_arn = "arn:aws:s3:::${var.pipeline_artifacts_bucket_name}"
  frontend_bucket_arn           = "arn:aws:s3:::${var.frontend_bucket_name}"

  ec2_log_group_arn              = "arn:aws:logs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:log-group:/hisaab/api:*"
  postconfirm_log_group_arn      = "arn:aws:logs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/lambda/fn-post-confirmation:*"
  reminder_log_group_arn         = "arn:aws:logs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/lambda/fn-reminder-dispatcher:*"
  email_sender_log_group_arn     = "arn:aws:logs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/lambda/fn-email-sender:*"
  codebuild_log_group_arn        = "arn:aws:logs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/codebuild/${var.codebuild_project_name}:*"
  canary_codebuild_log_group_arn = "arn:aws:logs:${var.aws_region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/codebuild/${var.canary_codebuild_project_name}:*"

  codebuild_project_arn = "arn:aws:codebuild:${var.aws_region}:${data.aws_caller_identity.current.account_id}:project/${var.codebuild_project_name}"
  codedeploy_app_arn    = "arn:aws:codedeploy:${var.aws_region}:${data.aws_caller_identity.current.account_id}:application:${var.codedeploy_app_name}"
  codedeploy_dg_arn     = "arn:aws:codedeploy:${var.aws_region}:${data.aws_caller_identity.current.account_id}:deploymentgroup:${var.codedeploy_app_name}/*"
}

# --- role-ec2-hisaab --------------------------------------------------------

resource "aws_iam_role" "ec2_hisaab" {
  name = "role-ec2-hisaab"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Principal = { Service = "ec2.amazonaws.com" }
        Action    = "sts:AssumeRole"
      },
    ]
  })

  tags = {
    Name    = "role-ec2-hisaab"
    Project = "hisaab"
  }
}

resource "aws_iam_instance_profile" "ec2_hisaab" {
  name = "role-ec2-hisaab"
  role = aws_iam_role.ec2_hisaab.name

  tags = {
    Name    = "role-ec2-hisaab"
    Project = "hisaab"
  }
}

resource "aws_iam_role_policy_attachment" "ec2_hisaab_ssm" {
  role       = aws_iam_role.ec2_hisaab.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_role_policy" "ec2_hisaab" {
  name = "role-ec2-hisaab-permissions"
  role = aws_iam_role.ec2_hisaab.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "EcrAuth"
        Effect   = "Allow"
        Action   = "ecr:GetAuthorizationToken"
        Resource = "*" # AWS requires "*" here; the action has no resource-level permissions.
      },
      {
        Sid    = "EcrPull"
        Effect = "Allow"
        # BatchGetImage alone only fetches the image manifest — a real
        # `docker pull` also needs these two to actually fetch layer
        # blobs. Confirmed missing the hard way: docker pull resolved the
        # correct manifest/tag but failed with an explicit AccessDenied on
        # ecr:GetDownloadUrlForLayer once the image tag itself was fixed.
        Action = [
          "ecr:BatchGetImage",
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
        ]
        Resource = local.ecr_repo_arn
      },
      {
        Sid    = "ProfilePicsRW"
        Effect = "Allow"
        Action = [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
        ]
        Resource = "${local.profile_pics_bucket_arn}/*"
      },
      {
        # CodeDeploy's DownloadBundle command runs as this instance role,
        # not role-codedeploy — it needs to fetch the deployment revision
        # (appspec.yml + scripts) CodePipeline staged in this bucket.
        # Confirmed missing the hard way via the CodeDeploy agent's own
        # log: DownloadBundle failed with AccessDenied on s3:GetObject,
        # which is why deployed instances kept running the image baked
        # into the launch template instead of picking up new commits.
        Sid      = "ReadPipelineArtifacts"
        Effect   = "Allow"
        Action   = "s3:GetObject"
        Resource = "${local.pipeline_artifacts_bucket_arn}/*"
      },
      {
        # Enqueues {to, subject, body} for group invites, expense-added,
        # and settlement-recorded events — fn-email-sender (SQS-triggered)
        # does the actual SES send. Replaces the old direct sns:Publish;
        # there's no more subscribe/confirm step to grant permissions for.
        Sid      = "EnqueueNotifications"
        Effect   = "Allow"
        Action   = "sqs:SendMessage"
        Resource = local.sqs_queue_arn
      },
      {
        Sid      = "OwnLogGroup"
        Effect   = "Allow"
        Action   = "logs:*"
        Resource = local.ec2_log_group_arn
      },
    ]
  })
}

# --- role-lambda-postconfirm ------------------------------------------------

resource "aws_iam_role" "lambda_postconfirm" {
  name = "role-lambda-postconfirm"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Principal = { Service = "lambda.amazonaws.com" }
        Action    = "sts:AssumeRole"
      },
    ]
  })

  tags = {
    Name    = "role-lambda-postconfirm"
    Project = "hisaab"
  }
}

resource "aws_iam_role_policy_attachment" "lambda_postconfirm_vpc" {
  role       = aws_iam_role.lambda_postconfirm.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
}

resource "aws_iam_role_policy" "lambda_postconfirm" {
  name = "role-lambda-postconfirm-permissions"
  role = aws_iam_role.lambda_postconfirm.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        # ses:VerifyEmailIdentity, not SendCustomVerificationEmail — the
        # custom-branded version turned out to itself require production
        # access to use at all, which defeats the point on a sandboxed
        # account (see modules/messaging/ses.tf). Resource = "*"
        # preemptively: ses:SendEmail already taught us the hard way that
        # SES actions authorize against the *recipient's* identity ARN
        # too, which by definition can't be pre-declared for an arbitrary
        # new signup.
        Sid      = "VerifyRecipientEmail"
        Effect   = "Allow"
        Action   = "ses:VerifyEmailIdentity"
        Resource = "*"
      },
      {
        Sid      = "OwnLogGroup"
        Effect   = "Allow"
        Action   = "logs:*"
        Resource = local.postconfirm_log_group_arn
      },
    ]
  })
}

