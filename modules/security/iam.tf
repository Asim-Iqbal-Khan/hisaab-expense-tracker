      },
    ]
  })

  tags = {
    Name    = "role-codedeploy"
    Project = "hisaab"
  }
}

resource "aws_iam_role_policy_attachment" "codedeploy" {
  role       = aws_iam_role.codedeploy.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSCodeDeployRole"
}

# AWSCodeDeployRole omits two things it needs for this specific setup —
# neither can live in a generic AWS-managed policy since both depend on
# choices this project made:
#
#  1. iam:PassRole for the EC2 instance profile — AWS can't know which
#     instance-profile role you'll use.
#  2. ec2:DescribeLaunchTemplate(Versions) — the managed policy's only EC2
#     grants are DescribeInstances/DescribeInstanceStatus/TerminateInstances
#     (confirmed by reading the actual policy document); it has nothing for
#     reading a launch template, but asg-hisaab-blue is defined via one
#     (not a launch configuration), and copying it (green_fleet_provisioning
#     = COPY_AUTO_SCALING_GROUP) requires CodeDeploy to read it first.
#
# Confirmed both were missing the hard way: attaching AdministratorAccess
# as a diagnostic test changed the failure from a generic AmazonAutoScaling
# permission error to a distinct, unrelated validation error further into
# the deployment, proving permission gaps outside the autoscaling:
# namespace were the real cause — then adding iam:PassRole alone reproduced
# the exact original error again, showing it wasn't sufficient by itself.
resource "aws_iam_role_policy" "codedeploy_pass_role" {
  name = "role-codedeploy-pass-role"
  role = aws_iam_role.codedeploy.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "PassEc2InstanceRole"
        Effect   = "Allow"
        Action   = "iam:PassRole"
        Resource = aws_iam_role.ec2_hisaab.arn
        Condition = {
          StringEquals = {
            "iam:PassedToService" = "ec2.amazonaws.com"
          }
        }
      },
      {
        Sid    = "ReadLaunchTemplate"
        Effect = "Allow"
        Action = [
          "ec2:DescribeLaunchTemplates",
          "ec2:DescribeLaunchTemplateVersions",
        ]
        # Describe actions on this resource type don't support
        # resource-level scoping — same reasoning AWSCodeDeployRole itself
        # uses for its own ec2:Describe* grants (Resource: "*").
        Resource = "*"
      },
    ]
  })
}

# --- role-codepipeline --------------------------------------------------------
# codestar-connections:UseConnection is deliberately omitted — see the note
# at the top of this file. modules/pipeline attaches it once the connection
# exists.

resource "aws_iam_role" "codepipeline" {
  name = "role-codepipeline"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Principal = { Service = "codepipeline.amazonaws.com" }
        Action    = "sts:AssumeRole"
      },
    ]
  })

  tags = {
    Name    = "role-codepipeline"
    Project = "hisaab"
  }
}

resource "aws_iam_role_policy" "codepipeline" {
  name = "role-codepipeline-permissions"
  role = aws_iam_role.codepipeline.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "InvokeBuild"
        Effect = "Allow"
        Action = [
          "codebuild:StartBuild",
          "codebuild:BatchGetBuilds",
        ]
        Resource = local.codebuild_project_arn
      },
      {
        Sid    = "InvokeDeploy"
        Effect = "Allow"
        Action = [
          "codedeploy:CreateDeployment",
          "codedeploy:GetDeployment",
          "codedeploy:GetApplicationRevision",
          "codedeploy:RegisterApplicationRevision",
        ]
        Resource = [
          local.codedeploy_app_arn,
          local.codedeploy_dg_arn,
        ]
      },
      {
        Sid    = "DeploymentConfig"
        Effect = "Allow"
        Action = "codedeploy:GetDeploymentConfig"
        # Deployment configs (e.g. CodeDeployDefault.OneAtATime) are
        # predefined, but CodeDeploy resolves them under the *caller's*
        # account ID at runtime, not the "aws" pseudo-account the docs
        # imply — confirmed by an actual PermissionError naming the real
        # account ID in the resource ARN. Granting both forms since AWS's
        # own behavior here is inconsistent across API paths.
        Resource = [
          "arn:aws:codedeploy:${var.aws_region}:aws:deploymentconfig:*",
          "arn:aws:codedeploy:${var.aws_region}:${data.aws_caller_identity.current.account_id}:deploymentconfig:*",
        ]
      },
      {
        Sid    = "ArtifactBucketRW"
        Effect = "Allow"
        Action = [
          "s3:GetObject",
          "s3:PutObject",
          "s3:GetBucketVersioning",
        ]
        Resource = [
          local.pipeline_artifacts_bucket_arn,
          "${local.pipeline_artifacts_bucket_arn}/*",
        ]
      },
    ]
  })
}
