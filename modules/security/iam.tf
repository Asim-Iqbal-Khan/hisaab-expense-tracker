# --- role-codebuild-canary -----------------------------------------------------
# Deliberately a separate role from role-codebuild rather than widening it —
# the canary orchestrator's job (push a build to one EC2 instance via SSM,
# move ALB listener weights, poll CloudWatch alarms) has nothing to do with
# role-codebuild's ECR/S3 concerns, same reasoning that kept role-terraform
# and role-codebuild split apart rather than merged.

resource "aws_iam_role" "codebuild_canary" {
  name = "role-codebuild-canary"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Principal = { Service = "codebuild.amazonaws.com" }
        Action    = "sts:AssumeRole"
      },
    ]
  })

  tags = {
    Name    = "role-codebuild-canary"
    Project = "hisaab"
  }
}

resource "aws_iam_role_policy" "codebuild_canary" {
  name = "role-codebuild-canary-permissions"
  role = aws_iam_role.codebuild_canary.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        # The CODEPIPELINE artifact type means CodeBuild's own role reads
        # the input artifact directly from S3 (same as role-codebuild's
        # ArtifactBucketRW) — read-only here since this project never
        # produces a downstream artifact of its own, only an exported
        # pipeline variable (CANARY_PASSED).
        Sid      = "ArtifactBucketRead"
        Effect   = "Allow"
        Action   = "s3:GetObject"
        Resource = "${local.pipeline_artifacts_bucket_arn}/*"
      },
      {
        # Describe actions don't support resource-level scoping — same
        # reasoning already used for role-codedeploy's ReadLaunchTemplate
        # grant above.
        Sid      = "FindCanaryInstance"
        Effect   = "Allow"
        Action   = "ec2:DescribeInstances"
        Resource = "*"
      },
      {
        # Scoped by tag, not a hardcoded instance ID — the canary ASG could
        # in principle replace its instance (e.g. a failed health check),
        # and this grant must keep working against whatever instance
        # currently carries Role=canary.
        Sid      = "SendCommandToCanaryInstance"
        Effect   = "Allow"
        Action   = "ssm:SendCommand"
        Resource = "arn:aws:ec2:${var.aws_region}:${data.aws_caller_identity.current.account_id}:instance/*"
        Condition = {
          StringEquals = {
            "ssm:resourceTag/Role" = "canary"
          }
        }
      },
      {
        Sid      = "SendCommandDocument"
        Effect   = "Allow"
        Action   = "ssm:SendCommand"
        Resource = "arn:aws:ssm:${var.aws_region}::document/AWS-RunShellScript"
      },
      {
        # GetCommandInvocation doesn't support resource-level scoping
        # either (its ARN is per command-id/instance-id, both dynamic).
        Sid      = "PollCommandStatus"
        Effect   = "Allow"
        Action   = "ssm:GetCommandInvocation"
        Resource = "*"
      },
      {
        # elasticloadbalancing:ModifyListener (the actual weight-shifting
        # grant) is deliberately not here — it needs to be scoped to the
        # specific listener ARN, which doesn't exist yet at this point in
        # the module graph (modules/compute is created *from* modules/security's
        # outputs, so the reverse would be a cycle). Attached instead in
        # modules/compute once the listener exists, same deferred-permission
        # pattern already used there for codedeploy_run_instances.
        Sid    = "ReadCanaryTrafficState"
        Effect = "Allow"
        Action = [
          "elasticloadbalancing:DescribeListeners",
          "elasticloadbalancing:DescribeTargetHealth",
        ]
        Resource = "*"
      },
      {
        # DescribeAlarms doesn't support resource-level scoping.
        Sid      = "PollCanaryAlarms"
        Effect   = "Allow"
        Action   = "cloudwatch:DescribeAlarms"
        Resource = "*"
      },
      {
        Sid      = "OwnLogGroup"
        Effect   = "Allow"
        Action   = "logs:*"
        Resource = local.canary_codebuild_log_group_arn
      },
    ]
  })
}

