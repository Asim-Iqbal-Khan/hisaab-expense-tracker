# --- role-lambda-email-sender ------------------------------------------------
# No VPC access policy attachment — this Lambda isn't placed in the VPC at
# all (see modules/messaging/lambda.tf), it only talks to SQS and SES.

resource "aws_iam_role" "lambda_email_sender" {
  name = "role-lambda-email-sender"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Principal = { Service = "lambda.amazonaws.com" }
        Action    = "sts:AssumeRole"
      },
    ]
  })

  tags = {
    Name    = "role-lambda-email-sender"
    Project = "hisaab"
  }
}

resource "aws_iam_role_policy" "lambda_email_sender" {
  name = "role-lambda-email-sender-permissions"
  role = aws_iam_role.lambda_email_sender.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "ConsumeNotifications"
        Effect = "Allow"
        Action = [
          "sqs:ReceiveMessage",
          "sqs:DeleteMessage",
          "sqs:GetQueueAttributes",
        ]
        Resource = local.sqs_queue_arn
      },
      {
        # ses:SendEmail's IAM authorization checks BOTH the sending
        # identity and each recipient address as its own identity ARN —
        # confirmed the hard way via the actual AccessDenied message
        # ("... not authorized to perform ses:SendEmail on resource
        # arn:aws:ses:...:identity/<recipient-email>"), naming a random
        # invitee's address, not the sending domain. Since this Lambda
        # legitimately sends to arbitrary real user addresses (not a fixed
        # set), Resource can't be scoped to just the FROM identity the way
        # it looks like it should be — same "takes a resource ARN
        # parameter that doesn't actually support scoping the way you'd
        # expect" pattern as sns:GetSubscriptionAttributes above.
        Sid    = "SendEmail"
        Effect = "Allow"
        Action = [
          "ses:SendEmail",
          "ses:SendRawEmail",
        ]
        Resource = "*"
      },
      {
        Sid      = "OwnLogGroup"
        Effect   = "Allow"
        Action   = "logs:*"
        Resource = local.email_sender_log_group_arn
      },
    ]
  })
}

