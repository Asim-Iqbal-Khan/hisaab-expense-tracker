# Baked into the built bundle at build time (Vite exposes any VITE_-prefixed
# env var via import.meta.env). In CI these come from CodeBuild's
# environment_variable blocks (modules/pipeline/codebuild.tf); for local dev
# against the real Cognito pool, copy this to .env.local and fill in real
# values (see envs/prod outputs: app_client_id, or `terraform output` in
# envs/prod).
VITE_COGNITO_CLIENT_ID=changeme
VITE_COGNITO_REGION=us-west-2
