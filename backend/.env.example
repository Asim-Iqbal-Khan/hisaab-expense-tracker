PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hisaab
DB_SECRET_JSON={"username":"hisaab_admin","password":"changeme"}
# A plain local Postgres (e.g. `docker run postgres:16`) has no SSL configured —
# set to 0 for local dev. Never set this in the real deployed environment; RDS
# requires SSL and rejects unencrypted connections outright.
DB_SSL=0
AWS_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_changeme
COGNITO_APP_CLIENT_ID=changeme
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/changeme/hisaab-notifications
# Optional, unlike everything else above — leave unset for local dev and the
# balance cache (cache.ts) just always misses and hits the database, no real
# Redis instance needed. The real deployed app.env always sets this.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# Local-dev only — never set this in the real deployed environment. Lets
# requireAuth skip Cognito token verification (so you don't need a real
# signed-in session/token) so you can iterate on routes/queries without
# redeploying. See backend/src/auth.ts.
DEV_BYPASS_AUTH=1
